# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# dati personali clienti (mai versionare): l'anagrafica resta fuori dal repo
/data/
# loghi caricati dall'amministratore (cartella runtime, come data/)
/public/logos/
# anagrafica clienti anche nella root del progetto (mai versionare)
/anagrafica_clienti.xlsx
# credenziali database locali (mai versionare)
/db.txt
*.tsbuildinfo
next-env.d.ts

# log di sviluppo (mai versionare)
dev-*.txt
dev-server*.log
*.log

# file temporanei di Office/Excel (file di blocco)
~$*
